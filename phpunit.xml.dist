<?xml version="1.0"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	cacheDirectory=".phpunit.cache"
	colors="true"
	failOnWarning="true"
	failOnNotice="true"
	failOnDeprecation="true"
	defaultTestSuite="unit"
>
	<php>
		<!-- The wordpress suite (Patchwork instruments every class it loads) needs more than PHP 8.2's default 128M. -->
		<ini name="memory_limit" value="512M"/>
	</php>

	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">./tests/Unit</directory>
		</testsuite>
		<testsuite name="wordpress">
			<directory suffix="Test.php">./tests/WordPress</directory>
		</testsuite>
		<testsuite name="e2e">
			<directory suffix="Test.php">./tests/E2E</directory>
		</testsuite>
		<testsuite name="integration">
			<directory suffix="Test.php">./tests/Integration</directory>
		</testsuite>
	</testsuites>

	<source>
		<include>
			<directory suffix=".php">./includes</directory>
		</include>
	</source>
</phpunit>
