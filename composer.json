{
    "name": "lwplugins/lw-migration",
    "description": "Lightweight backup, restore and migration for WordPress, compatible with .wpress archives.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "LW Plugins",
            "homepage": "https://lwplugins.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "php-stubs/wp-cli-stubs": "dev-master#335d4890308f9fbb3427c56412d30f157d21f697",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "LightweightPlugins\\Migration\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LightweightPlugins\\Migration\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=2G",
        "test": [
            "php -d auto_prepend_file=tests/prepend.php vendor/phpunit/phpunit/phpunit --testsuite unit",
            "php -d auto_prepend_file=tests/prepend.php vendor/phpunit/phpunit/phpunit --testsuite wordpress"
        ],
        "test:db": "bash bin/test-db.sh"
    }
}
