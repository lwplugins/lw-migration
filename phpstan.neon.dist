includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 5

	# Analyse against the lowest supported PHP so 8.1+ syntax cannot slip in.
	phpVersion:
		min: 80000
		max: 80599

	paths:
		- lw-migration.php
		- uninstall.php
		- includes/

	excludePaths:
		analyseAndScan:
			- tests/
			- vendor/
		analyse:
			# Generated by bin/vendor-sftp.sh; scanned for its classes, not analysed.
			- includes/Vendor/

	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php

	bootstrapFiles:
		- phpstan-bootstrap.php
