#. translators: %s: name of the connected site.
#: build/index.js:124
msgid "Connected with %s."
msgstr "Összekapcsolva ezzel: %s."

#: build/index.js:124
msgid "Connect"
msgstr "Kapcsolódás"

#: build/index.js:124
