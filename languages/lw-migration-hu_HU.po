#: includes/Admin/AdminPage.php:186
msgid ""
"The LW Migration admin screen is missing (build/index.js). Reinstall the "
"plugin from a release package, or run \"npm run build\" in a development "
"copy."
msgstr ""
"Hiányzik az LW Migration admin felülete (build/index.js). Telepítsd újra a "
"bővítményt egy kiadott csomagból, vagy futtasd az \"npm run build\" "
"parancsot a fejlesztői példányban."

#: includes/Admin/AdminPage.php:239
msgid ""
"Migrations of this network are under Network Admin > Settings > Migration."
msgstr ""
"A hálózat költöztetése itt érhető el: Hálózat kezelő > Beállítások > "
"Költöztetés."

#: includes/Admin/AdminPage.php:241
msgid "Open the network page"
msgstr "Hálózati oldal megnyitása"

#: includes/Admin/Hub/Activator.php:48
msgid "This is not an LW plugin."
msgstr "Ez nem LW bővítmény."

#: includes/Admin/Hub/Activator.php:54
msgid "This plugin is not installed."
msgstr "Ez a bővítmény nincs telepítve."

#: includes/Admin/Hub/Activator.php:62
msgid "You are not allowed to activate this plugin."
msgstr "Nincs jogod bekapcsolni ezt a bővítményt."

#: includes/Admin/Hub/Page.php:135
msgid ""
"The LW Plugins page files are missing. Re-install the plugin from a release "
"ZIP."
msgstr ""
"Hiányoznak az LW Plugins oldal fájljai. Telepítsd újra a bővítményt egy "
"kiadási ZIP-ből."

#: includes/Admin/Hub/RegistryFallback.php:32
msgid "GDPR-compliant cookie consent banner."
msgstr "GDPR-kompatibilis sütihozzájárulási sáv."

#: includes/Admin/Hub/RegistryFallback.php:41
msgid "Disable WordPress features like comments."
msgstr "WordPress-funkciók kikapcsolása, például a hozzászólásoké."

#: includes/Admin/Hub/RegistryFallback.php:50
msgid "Enable WordPress features: SVG uploads and more."
msgstr "WordPress-funkciók bekapcsolása: SVG-feltöltés és egyebek."

#: includes/Admin/Hub/RegistryFallback.php:59
msgid "Rate limiting, bot blocking, IP bans and security headers."
msgstr "Kéréskorlátozás, botszűrés, IP-tiltás és biztonsági fejlécek."

#: includes/Admin/Hub/RegistryFallback.php:68
msgid ""
"Lightweight image optimization — auto-convert uploads to WebP via HelloImg."
msgstr ""
"Könnyű képoptimalizálás: a feltöltések automatikus WebP-konverziója a "
"HelloImg-gel."

#: includes/Admin/Hub/RegistryFallback.php:77
msgid ""
"Headless LMS backend: courses, lessons, access, progress and quizzes over a "
"REST API."
msgstr ""
"Headless LMS-háttér: kurzusok, leckék, hozzáférés, haladás és kvízek REST "
"API-n."

#: includes/Admin/Hub/RegistryFallback.php:86
msgid ""
"Tracking pixels: Meta, GA4, Ads, GTM, TikTok, Pinterest, Bing, Reddit, "
"Snapchat, X."
msgstr ""
"Követőpixelek: Meta, GA4, Ads, GTM, TikTok, Pinterest, Bing, Reddit, "
"Snapchat, X."

#: includes/Admin/Hub/RegistryFallback.php:95
msgid "Malware scanner for files, the database and vulnerable software."
msgstr ""
"Kártevőkereső a fájlokhoz, az adatbázishoz és a sérülékeny szoftverekhez."

#: includes/Admin/Hub/RegistryFallback.php:104
msgid "Essential SEO features without the bloat."
msgstr "A lényeges SEO-funkciók, felesleg nélkül."

#: includes/Admin/Hub/RegistryFallback.php:113
msgid "Site maintenance via AI/REST using Abilities API."
msgstr "Oldalkarbantartás AI-on és REST-en át, az Abilities API-val."

#: includes/Admin/Hub/RegistryFallback.php:122
msgid "Manage WordPress translations from community repositories."
msgstr "WordPress-fordítások kezelése közösségi tárolókból."

#: includes/Admin/Hub/RegistryFallback.php:131
msgid "Clean up your admin — notices sidebar & widget manager."
msgstr "Rendezett admin: értesítési oldalsáv és widgetkezelő."

#: includes/Admin/SubsiteNotice.php:38
msgid ""
"LW Migration does nothing on this site: on a network it works only when it "
"is network-activated, from Network Admin."
msgstr ""
"Az LW Migration ezen a honlapon nem csinál semmit: hálózaton csak hálózati "
"bekapcsolással működik, a Hálózat kezelőből."

#. translators: %s: absolute path of the default backups folder
#: includes/CLI/BackupDirCommand.php:45
#, php-format
msgid "default (%s)"
msgstr "alapértelmezett (%s)"

#. translators: %s: the backups folder
#. translators: %s: the backups folder, e.g. wp-content/lw-migration-backups.
#: includes/CLI/BackupDirCommand.php:47 build/index.js:158
#, php-format
msgid "Backups folder: %s"
msgstr "Mentésmappa: %s"

#: includes/CLI/BackupDirCommand.php:53 build/index.js:255
msgid "the default folder"
msgstr "az alapértelmezett mappa"

#. translators: 1: target folder, 2: number of backups
#: includes/CLI/BackupDirCommand.php:56
#, php-format
msgid ""
"A move to %1$s has not finished: %2$d backup is still in the folder above. "
"Run the move again to finish it, or move to the folder above to undo it."
msgid_plural ""
"A move to %1$s has not finished: %2$d backups are still in the folder above. "
"Run the move again to finish it, or move to the folder above to undo it."
msgstr[0] ""
"Nem fejeződött be az áthelyezés ide: %1$s. %2$d mentés még a fenti mappában "
"van. Futtasd újra az áthelyezést a befejezéshez, vagy helyezd át a "
"mentéseket a fenti mappába a visszavonáshoz."
msgstr[1] ""
"Nem fejeződött be az áthelyezés ide: %1$s. %2$d mentés még a fenti mappában "
"van. Futtasd újra az áthelyezést a befejezéshez, vagy helyezd át a "
"mentéseket a fenti mappába a visszavonáshoz."

#: includes/CLI/BackupDirCommand.php:156
msgid "Give the new folder, or one of --default, --finish, --undo."
msgstr ""
"Add meg az új mappát, vagy a --default, --finish, --undo kapcsolók egyikét."

#. translators: 1: number of backups, 2: their size, 3: folder
#: includes/CLI/BackupDirCommand.php:180
#, php-format
msgid ""
"Move %1$d backup (%2$s) to %3$s? Scheduled backups wait, and no backup or "
"restore can start until it is done. [y/n]"
msgid_plural ""
"Move %1$d backups (%2$s) to %3$s? Scheduled backups wait, and no backup or "
"restore can start until it is done. [y/n]"
msgstr[0] ""
"Áthelyezel %1$d mentést (%2$s) ide: %3$s? Az ütemezett mentések várnak, és "
"amíg el nem készül, nem indíthatsz mentést vagy visszaállítást. [y/n]"
msgstr[1] ""
"Áthelyezel %1$d mentést (%2$s) ide: %3$s? Az ütemezett mentések várnak, és "
"amíg el nem készül, nem indíthatsz mentést vagy visszaállítást. [y/n]"

#: includes/CLI/BackupDirCommand.php:194
msgid "Pass --yes to move without a prompt."
msgstr "Kérdés nélküli áthelyezéshez add meg a --yes kapcsolót."

#: includes/CLI/BackupDirCommand.php:197
msgid "Nothing moved."
msgstr "Semmi nem lett áthelyezve."

