msgstr[1] "Hálózati archívum: %d honlap megtartja az azonosítóját."

#. translators: %s: list of site addresses
#: includes/Multisite/NetworkSummary.php:90 build/index.js:15
#, php-format
msgid ""
"Not in the archive: %s. These sites stay on the network marked as deleted "
