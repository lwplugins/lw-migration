#: includes/Storage/Destinations/Ftp/FtpType.php:71 build/index.js:19
msgid "Encryption"
msgstr "Titkosítás"

#: includes/Storage/Destinations/Ftp/FtpType.php:73
msgid ""
"FTPS encrypts the connection and checks the server's certificate. A "
"certificate no certificate authority vouches for (a self-signed one, say) is "
"shown at the connection check for you to confirm. Plain FTP sends the "
"password and the backups unencrypted."
msgstr ""
"Az FTPS titkosítja a kapcsolatot, és ellenőrzi a szerver tanúsítványát. Az "
"olyan tanúsítványt, amelyet egyik hitelesítésszolgáltató sem igazol (például "
"egy önaláírtat), a kapcsolatellenőrzés megmutatja, hogy jóváhagyd. A sima "
"FTP titkosítatlanul küldi a jelszót és a mentéseket."

#: includes/Storage/Destinations/Ftp/FtpType.php:75
msgid "FTPS (explicit TLS)"
msgstr "FTPS (explicit TLS)"

#: includes/Storage/Destinations/Ftp/FtpType.php:76
msgid "None (plain FTP)"
msgstr "Nincs (sima FTP)"

#: includes/Storage/Destinations/Ftp/FtpType.php:80
msgid "Passive mode"
msgstr "Passzív mód"

#: includes/Storage/Destinations/Ftp/FtpType.php:80
msgid "Leave it on unless your server asks for active mode."
msgstr "Hagyd bekapcsolva, hacsak a szervered nem kér aktív módot."

#: includes/Storage/Destinations/Ftp/FtpType.php:81
#: includes/Storage/Destinations/Sftp/SftpType.php:64
#: includes/Storage/Destinations/WebDav/WebDavType.php:79
msgid "User name"
msgstr "Felhasználónév"

#: includes/Storage/Destinations/Ftp/FtpType.php:82
