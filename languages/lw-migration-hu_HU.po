msgstr ""
"Ezek a honlapok nincsenek az archívumban, de az archívumban van honlap a "
"címükön, ezért új címen maradtak meg: %s"

#. translators: %d: number of sites in the archive
#: includes/Multisite/NetworkSummary.php:82
#, php-format
msgid "Network archive: %d site keeps its ID."
