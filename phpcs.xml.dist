<?xml version="1.0"?>
<ruleset name="LW Migration Coding Standards">
    <description>PHP CodeSniffer ruleset for LW Migration.</description>

    <file>.</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/src/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/.superpowers/*</exclude-pattern>
    <exclude-pattern>/docs/*</exclude-pattern>
    <!-- Generated by bin/vendor-sftp.sh from phpseclib and constant_time_encoding (MIT); never edited by hand. -->
    <exclude-pattern>/includes/Vendor/*</exclude-pattern>

    <arg value="ps"/>
    <arg name="colors"/>

    <rule ref="WordPress">
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
        <exclude name="Squiz.PHP.CommentedOutCode"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
        <!-- The archive engine is WordPress-independent and works on raw streams. -->
        <exclude name="WordPress.WP.AlternativeFunctions"/>
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode"/>
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode"/>
        <!-- Exception messages are not HTML output. -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
        <!-- Value objects and cursors use camelCase public properties. -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
    </rule>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.0-"/>
    <config name="minimum_wp_version" value="6.6"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="lw-migration"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="lw_migration"/>
                <element value="LW_MIGRATION"/>
                <element value="lw_plugins"/>
                <element value="LightweightPlugins\Migration"/>
            </property>
        </properties>
    </rule>
    <!-- The database layer wraps the mysqli link WordPress itself opened ($wpdb->dbh). -->
    <rule ref="WordPress.DB.RestrictedClasses">
        <exclude-pattern>/includes/Database/MysqliConnection.php</exclude-pattern>
        <exclude-pattern>/includes/WordPress/WpConnection.php</exclude-pattern>
    </rule>
</ruleset>
